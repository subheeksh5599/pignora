# Pignora backend configuration.
# No secrets in code: everything comes from env with a mock fallback.

# mock (hermetic tests only) | sandbox (default — Cleanverse UAT API + Monad testnet)
CLEANVERSE_MODE=sandbox

# Cleanverse sandbox API (uat = sandbox; requires no org key for skill endpoints)
CLEANVERSE_API=https://uatapi.cleanverse.com/api/skills

# Cleanverse cooperate API (v5.6). Sandbox defaults; prod = api.cleanverse.com/api/cooperate
CLEANVERSE_COOPERATE_API=https://uatapi.cleanverse.com/api/cooperate
# Your api-id (issued by Cleanverse) — put the real value in .env, never in this file
CLEANVERSE_API_ID=
# Base64 AES key — used locally to encrypt request bodies, NEVER sent, NEVER committed
CLEANVERSE_API_KEY=
CLEANVERSE_CHAIN=monad

# Monad testnet (verified live Aug 2026)
MONAD_CHAIN_ID=10143
MONAD_RPC=https://monad-testnet.g.alchemy.com/v2/_ztkT79iUO-dFpkTNDBFB

# Verified contract addresses (Monad testnet, checked live)
AUSDC_ADDRESS=0xfa96de5b8f434c26fdff953303dd66ff80af1026
APASS_ADDRESS=0xbA82D189540CaC9DC6FF46B6837CaC1BFdEC58B9

# Pignora deployments (set after deploy)
REPO_DESK_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=

# Relay key: the hackathon deployer key that updates IdentityRegistry.
# Only needed for sandbox-mode relay writes. NEVER commit this file with a key.
RELAY_KEY=

PORT=8787
